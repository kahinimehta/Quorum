# Copy to .env and fill in.

# --- Supabase (team shared DB) — Connect → Session pooler → URI (IPv4 on free tier)
# NOT db.*.supabase.co (Direct) and NOT Transaction pooler if IPv6-only on your network
SUPABASE_DATABASE_URL=
# SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# --- Next.js dashboard (Person 5) — Framework tab or API Keys (not the URI above)
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Literature agent extraction
# EXTRACT_BACKEND=nebius   # team default | ollama | none
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=mistral

# --- Nebius (when EXTRACT_BACKEND=nebius or unset with keys below)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_MODEL=

# --- Local SQLite override (optional; ignored when SUPABASE_DATABASE_URL is set)
# NEURODISCOVER_DB=/tmp/my-neurodiscover.db

# Optional: BioMCP binary if not on PATH (default: .venv/bin/biomcp or `which biomcp`)
# BIOMCP_BIN=/path/to/biomcp

# Optional: BioMCP NCI source (not needed for Parkinson's)
# BIOMCP_NCI_API_KEY=
