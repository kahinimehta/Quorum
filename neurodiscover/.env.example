# Copy to .env and fill in.

# --- Supabase (team shared DB) — get from Supabase → Project Settings → Database → URI
# When set, all agents and cli.py use Postgres instead of local neurodiscover.db
SUPABASE_DATABASE_URL=
# SUPABASE_DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- Literature agent extraction
# EXTRACT_BACKEND=nebius   # team default | ollama | none
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=mistral

# --- Nebius (when EXTRACT_BACKEND=nebius or unset with keys below)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_MODEL=

# --- Local SQLite override (optional; ignored when SUPABASE_DATABASE_URL is set)
# NEURODISCOVER_DB=/tmp/my-neurodiscover.db

# Optional: BioMCP binary if not on PATH (default: .venv/bin/biomcp or `which biomcp`)
# BIOMCP_BIN=/path/to/biomcp

# Optional: BioMCP NCI source (not needed for Parkinson's)
# BIOMCP_NCI_API_KEY=
