# Copy to .env and fill in.

# --- Supabase (team shared DB) — Connect → Session pooler → URI (IPv4 on free tier)
# NOT db.*.supabase.co (Direct) and NOT Transaction pooler if IPv6-only on your network
SUPABASE_DATABASE_URL=
# SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# --- Dashboard frontend (index.html) — Project Settings → API → anon/public key
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=

# --- Optional: same keys for index.html (Project Settings → API → anon key)
# If unset, the dashboard uses http://127.0.0.1:5000 only (recommended for make dashboard).

# --- Literature agent extraction
# EXTRACT_BACKEND=nebius   # team default | ollama | none
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=mistral

# --- Nebius (when EXTRACT_BACKEND=nebius or unset with keys below)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_MODEL=

# --- Local SQLite override (optional; ignored when SUPABASE_DATABASE_URL is set)
# NEURODISCOVER_DB=/tmp/my-neurodiscover.db

# Optional: BioMCP binary if not on PATH (default: .venv/bin/biomcp or `which biomcp`)
# BIOMCP_BIN=/path/to/biomcp

# Optional: MCP server wrappers (see docs/developer-reference/literature-pull.md)
# PUBMED_MCP_COMMAND='node /path/to/pubmed-mcp/cli.js'
# BIORXIV_MCP_COMMAND='node /path/to/biorxiv-mcp/cli.js'

# Optional: Unpaywall for paywalled DOI → OA PDF fallback (requires real email)
# UNPAYWALL_EMAIL=you@example.com

# Optional: BioMCP NCI source (not needed for Parkinson's)
# BIOMCP_NCI_API_KEY=
